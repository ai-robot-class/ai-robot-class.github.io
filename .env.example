# 复制为 .env 并填入密钥（.env 已被 gitignore，不会上传）
# 必填：GitHub Token（无 Token 脚本会直接退出）
GITHUB_TOKEN=
# 可选：DeepSeek API（用于 AI 评分；未配置则仅用规则评分）
DEEPSEEK_API_KEY=
# 可选
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
# EVALUATION_END_DATE=2026-07-31
# DISABLE_AI_SCORING=0
